{% extends 'base.html.twig' %}

{% block title %}Détails du Chantier - ImmoSync{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/inspecteur.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/detail.css') }}">
{% endblock %}

{% block body %}
<!-- HEADER -->
<nav class="owner-navbar">
    <div class="header-flex">
        <div class="logo-area">
            <span class="logo-immo">IMMO</span><span class="logo-sync">SYNC</span>
        </div>

        <div style="text-align: center; flex: 1;">
            <p style="margin: 0; color: #666; font-size: 0.95rem;">Détails du Chantier</p>
        </div>

        <a href="{{ path('app_inspecteur_dashboard') }}" class="btn-back">← Retour</a>
    </div>
</nav>

<!-- CONTENU PRINCIPAL - LAYOUT EN 2 COLONNES -->
<div class="detail-container">
    <div class="detail-layout">
        <!-- GAUCHE : DÉTAILS -->
        <div class="detail-card">
            <div class="detail-header">
                <h1 class="detail-title">{{ chantier.bien.adresse }}</h1>
                <span style="background: #DCFCE7; color: #15803D; padding: 8px 16px; border-radius: 20px; font-weight: 700; font-size: 0.8rem;">
                    {{ chantier.statut|upper }}
                </span>
            </div>

            <div class="info-grid">
                <div class="info-box">
                    <div class="info-label">Ville</div>
                    <div class="info-value">{{ chantier.bien.ville }}</div>
                </div>

                <div class="info-box">
                    <div class="info-label">Code Postal</div>
                    <div class="info-value">{{ chantier.bien.codePostal }}</div>
                </div>

                <div class="info-box">
                    <div class="info-label">Surface</div>
                    <div class="info-value">{{ chantier.bien.surface }} m²</div>
                </div>

                <div class="info-box">
                    <div class="info-label">Date de Création</div>
                    <div class="info-value">{{ chantier.dateCreation|date('d/m/Y') }}</div>
                </div>
            </div>

            <div style="background: #F8FAFF; padding: 20px; border-radius: 12px; margin-top: 20px;">
                <div class="info-label">Description</div>
                <p style="color: #2D2D5A; margin-top: 10px; line-height: 1.6;">
                    {{ chantier.description }}
                </p>
            </div>
        </div>

        <!-- DROITE : CARTE -->
        <div id="map"></div>
    </div>
</div>

<script>
    // Fonction d'initialisation de la carte
    function initMap() {
        const latitude = {{ coordinates.lat }};
        const longitude = {{ coordinates.lng }};

        const map = new google.maps.Map(document.getElementById('map'), {
            zoom: 15,
            center: { lat: latitude, lng: longitude },
            mapTypeControl: true,
        });

        new google.maps.Marker({
            position: { lat: latitude, lng: longitude },
            map: map,
            title: '{{ chantier.bien.adresse|escape("js") }}',
        });
    }
</script>

<!-- Google Maps API avec callback -->
<script src="https://maps.googleapis.com/maps/api/js?key={{ googleMapsApiKey }}&callback=initMap" async defer></script>

{% endblock %}